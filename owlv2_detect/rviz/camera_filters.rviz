Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: filters
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Image
    Name: Original
    Enabled: true
    Normalize Range: false
    Min Value: 0
    Max Value: 255
    Median window: 5
    Topic:
      Value: /filters/original
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Value: true
